## Common Tasks

### 1. Extract a Single Play

```python
import re

def extract_play(text, play_name):
    """Extract a specific play from the complete works."""
    # Find play title
    pattern = play_name.upper()
    match = re.search(pattern, text)
    
    if not match:
        return None
    
    # Find start (beginning of play section)
    start = text.rfind('\n\n\n', 0, match.start())
    if start == -1:
        start = 0
    
    # Find end (next play marker or end of file)
    end = text.find('\n\n\n' + text[start:start+20].split('\n')[0], start + 100)
    if end == -1:
        end = len(text)
    
    return text[start:end]

# Usage
hamlet_text = extract_play(shakespeare_text, 'HAMLET')
print(f"Hamlet: {len(hamlet_text):,} characters")

# Get some famous lines
print(hamlet_text[:1000])  # First 1000 characters
```

### 2. Extract All Sonnets

```python
def extract_sonnets(text):
    """Extract all sonnets from the text."""
    start = text.find('THE SONNETS')
    end = text.find('ALL\'S WELL THAT ENDS WELL')
    
    if start != -1 and end != -1:
        return text[start:end]
    return None

# Usage
sonnets = extract_sonnets(shakespeare_text)
print(f"Sonnets: {len(sonnets):,} characters")
print(sonnets[:500])
```

### 3. Count Character Appearances

```python
def count_character_mentions(text, character_name):
    """Count how many times a character is mentioned."""
    # Simple word count (not perfect, but good approximation)
    pattern = f'\\b{character_name}\\b'
    matches = re.findall(pattern, text, re.IGNORECASE)
    return len(matches)

# Usage
hamlet_mentions = count_character_mentions(shakespeare_text, 'Hamlet')
print(f"Hamlet mentioned: {hamlet_mentions} times")

ophelia_mentions = count_character_mentions(shakespeare_text, 'Ophelia')
print(f"Ophelia mentioned: {ophelia_mentions} times")
```

