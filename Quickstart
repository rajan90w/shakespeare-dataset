### 5. Find Famous Quotes

```python
def find_quotes(text, search_term):
    """Find text containing specific phrases."""
    lines = text.split('\n')
    matching_lines = [line for line in lines 
                     if search_term.lower() in line.lower()]
    return matching_lines

# Usage
to_be_quotes = find_quotes(shakespeare_text, "To be")
print(f"Found {len(to_be_quotes)} lines with 'To be'")
for quote in to_be_quotes[:3]:
    print(f"  {quote.strip()}")

# Output:
# Found 5 lines with 'To be'
#   To be, or not to be, that is the question:
#   ...
```

## Advanced Usage

### Tokenization Analysis

```python
import re
from collections import Counter

def analyze_vocabulary(text, top_n=50):
    """Analyze vocabulary in the text."""
    # Extract words
    words = re.findall(r'\b[a-z]+\b', text.lower())
    
    # Count frequencies
    word_freq = Counter(words)
    
    # Get top words
    top_words = word_freq.most_common(top_n)
    
    return top_words

# Usage
top_50 = analyze_vocabulary(shakespeare_text, 50)
print("Top 50 most common words:")
for word, count in top_50[:20]:
    print(f"  {word}: {count:,}")
```

### Prepare for Fine-tuning

```python
import json

def prepare_finetuning_data(text, output_file, chunk_size=500):
    """Prepare data in JSONL format for fine-tuning."""
    lines = text.split('\n')
    chunks = []
    
    # Create chunks
    for i in range(0, len(lines), chunk_size):
        chunk = ' '.join(lines[i:i+chunk_size])
        if chunk.strip():
            chunks.append({'text': chunk})
    
    # Save as JSONL
    with open(output_file, 'w') as f:
        for chunk in chunks:
            f.write(json.dumps(chunk) + '\n')
    
    print(f"Created {len(chunks)} chunks in {output_file}")

# Usage
prepare_finetuning_data(shakespeare_text, 'shakespeare_training.jsonl')
```

### Calculate Dataset Statistics

```python
def get_dataset_stats(text):
    """Calculate comprehensive statistics."""
    lines = text.split('\n')
    words = text.split()
    chars = len(text)
    
    # Calculate averages
    avg_line_length = len(words) / len(lines)
    avg_word_length = chars / len(words)
    
    # Find longest lines
    longest_lines = sorted(lines, key=len, reverse=True)[:5]
    
    return {
        'total_lines': len(lines),
        'total_words': len(words),
        'total_characters': chars,
        'avg_line_length': round(avg_line_length, 2),
        'avg_word_length': round(avg_word_length, 2),
        'longest_line': longest_lines[0][:100] + '...',
    }

# Usage
stats = get_dataset_stats(shakespeare_text)
for key, value in stats.items():
    print(f"{key}: {value}")
```

## Using with Claude API

### Analyze Shakespeare Text with Claude

```python
import anthropic

client = anthropic.Anthropic()

# Load dataset
with open('final_dataset.txt', 'r') as f:
    full_text = f.read()

# Use just a portion for API call
sample_text = full_text[:10000]  # First 10K characters

response = client.messages.create(
    model="claude-3-5-sonnet-20241022",
    max_tokens=500,
    messages=[
        {
            "role": "user",
            "content": f"""Analyze the themes in this Shakespeare text:

{sample_text}

What are the main themes and emotions expressed?"""
        }
    ]
)

print(response.content[0].text)
```

